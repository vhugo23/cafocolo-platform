# Backend local/production environment example.
# Do not put real production secrets in this file.

# Server
PORT=8080

# Database
# IMPORTANT:
# Spring Boot needs a JDBC URL.
# Example local:
# jdbc:postgresql://localhost:5432/cafocolo
#
# Example production:
# jdbc:postgresql://HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/cafocolo
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Admin auth
CAFOCOLO_ADMIN_EMAIL=admin@cafocolo.local
CAFOCOLO_ADMIN_PASSWORD=admin123

# Use a long random secret in production.
CAFOCOLO_JWT_SECRET=change-this-secret-to-a-long-random-value-at-least-32-chars

# Local development:
CAFOCOLO_COOKIE_SECURE=false
CAFOCOLO_COOKIE_SAME_SITE=Lax
CAFOCOLO_FRONTEND_ORIGIN=http://localhost:3000

# Production example when frontend/backend are on different HTTPS domains:
# CAFOCOLO_COOKIE_SECURE=true
# CAFOCOLO_COOKIE_SAME_SITE=None
# CAFOCOLO_FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app